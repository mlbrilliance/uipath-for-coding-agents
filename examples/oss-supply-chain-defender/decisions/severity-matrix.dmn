<?xml version="1.0" encoding="UTF-8"?>
<!--
  AURORA — Severity classification DMN
  =====================================
  Bound by `process.bpmn::ScoreSeverity` business rule task.
  Hit policy: PRIORITY (highest-priority rule wins).
  Generated by `forger-maestro` from ADR; safe for humans to edit live.
-->
<definitions
    xmlns="https://www.omg.org/spec/DMN/20191111/MODEL/"
    xmlns:dmndi="https://www.omg.org/spec/DMN/20191111/DMNDI/"
    xmlns:dc="http://www.omg.org/spec/DMN/20180521/DC/"
    xmlns:di="http://www.omg.org/spec/DMN/20180521/DI/"
    xmlns:feel="https://www.omg.org/spec/DMN/20191111/FEEL/"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    id="severity-matrix-definitions"
    name="OSS supply-chain severity matrix"
    namespace="aurora.severity"
    exporter="aurora.forger-maestro"
    exporterVersion="0.1.0">

  <decision id="severity-matrix" name="Classify severity">
    <variable name="severity" typeRef="string" />

    <informationRequirement>
      <requiredInput href="#cvss" />
    </informationRequirement>
    <informationRequirement>
      <requiredInput href="#exploitInWild" />
    </informationRequirement>
    <informationRequirement>
      <requiredInput href="#depDepth" />
    </informationRequirement>
    <informationRequirement>
      <requiredInput href="#maintainerHealth" />
    </informationRequirement>
    <informationRequirement>
      <requiredInput href="#licenseRisk" />
    </informationRequirement>

    <decisionTable hitPolicy="PRIORITY" outputLabel="Severity bucket">
      <input id="cvss" label="Max CVSS score">
        <inputExpression typeRef="number"><text>cvss</text></inputExpression>
      </input>
      <input id="exploitInWild" label="Exploit observed in the wild">
        <inputExpression typeRef="boolean"><text>exploitInWild</text></inputExpression>
      </input>
      <input id="depDepth" label="Shallowest dep depth (1=direct)">
        <inputExpression typeRef="number"><text>depDepth</text></inputExpression>
      </input>
      <input id="maintainerHealth" label="OpenSSF Scorecard composite (0..10)">
        <inputExpression typeRef="number"><text>maintainerHealth</text></inputExpression>
      </input>
      <input id="licenseRisk" label="License conflict present">
        <inputExpression typeRef="boolean"><text>licenseRisk</text></inputExpression>
      </input>

      <output id="severityBucket" label="Severity" name="severity" typeRef="string" />

      <!-- Priority order (top wins): critical > high > medium > low > informational -->

      <rule id="r-critical-1">
        <description>Critical: CVSS ≥ 9.0 AND exploit observed</description>
        <inputEntry><text>>= 9.0</text></inputEntry>
        <inputEntry><text>true</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <outputEntry><text>"critical"</text></outputEntry>
      </rule>

      <rule id="r-critical-2">
        <description>Critical: CVSS ≥ 7.0 in a direct dep with no in-the-wild exploit</description>
        <inputEntry><text>>= 7.0</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <inputEntry><text>= 1</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <outputEntry><text>"critical"</text></outputEntry>
      </rule>

      <rule id="r-high-1">
        <description>High: CVSS ≥ 7.0 in a transitive dep</description>
        <inputEntry><text>>= 7.0</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <inputEntry><text>> 1</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <outputEntry><text>"high"</text></outputEntry>
      </rule>

      <rule id="r-high-2">
        <description>High: license conflict in a direct dep</description>
        <inputEntry><text>-</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <inputEntry><text>= 1</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <inputEntry><text>true</text></inputEntry>
        <outputEntry><text>"high"</text></outputEntry>
      </rule>

      <rule id="r-medium-1">
        <description>Medium: CVSS [4.0, 7.0) any depth</description>
        <inputEntry><text>[4.0..7.0)</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <outputEntry><text>"medium"</text></outputEntry>
      </rule>

      <rule id="r-medium-2">
        <description>Medium: maintainer health below 4 (abandoned dep candidate)</description>
        <inputEntry><text>-</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <inputEntry><text>&lt; 4</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <outputEntry><text>"medium"</text></outputEntry>
      </rule>

      <rule id="r-low">
        <description>Low: CVSS &lt; 4.0</description>
        <inputEntry><text>&lt; 4.0</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <outputEntry><text>"low"</text></outputEntry>
      </rule>

      <rule id="r-info">
        <description>Informational fallback (no input matched anything else)</description>
        <inputEntry><text>-</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <outputEntry><text>"informational"</text></outputEntry>
      </rule>
    </decisionTable>
  </decision>
</definitions>
