<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <RootNamespace>AuroraSupplyChainDefender.GitHub</RootNamespace>
    <AssemblyName>AuroraSupplyChainDefender.GitHub.PostPendingComment</AssemblyName>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <IsPackable>true</IsPackable>
    <PackageId>AuroraSupplyChainDefender.GitHub.PostPendingComment</PackageId>
    <Version>0.1.0</Version>
    <Description>PostPendingComment Coded Workflow for the AURORA Open-Source Supply-Chain Defender demo. Posts an idempotent audit-trail comment on a PR to signal that AURORA is watching for CI completion.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="UiPath.CodedWorkflows" Version="24.10.2" />
    <PackageReference Include="Octokit" Version="13.0.0" />
    <PackageReference Include="System.Text.Json" Version="8.0.5" />
  </ItemGroup>

</Project>
