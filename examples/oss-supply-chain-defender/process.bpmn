<?xml version="1.0" encoding="UTF-8"?>
<!--
  AURORA — Open-Source Supply-Chain Defender
  ============================================
  Generated by `forger-maestro` from ADR.
  Do not hand-edit; regenerate via `aurora` from policy + ADR.

  Process variables:
    GitHubOrg         : string
    ScanScope         : array<string>
    SeverityFloor     : number
    DigestChannel     : string
    EmergencyApprovers: array<string>
-->
<bpmn:definitions
    xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
    xmlns:dc="http://www.omg.org/dc"
    xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
    xmlns:dmn="https://www.omg.org/spec/DMN/20191111/MODEL/"
    xmlns:uipath="http://uipath.com/maestro/2024"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    id="OssSupplyChainDefender_Definitions"
    targetNamespace="https://aurora-demo-org/oss-supply-chain-defender">

  <bpmn:process id="OssSupplyChainDefender" name="OSS Supply-Chain Defender" isExecutable="true">

    <!-- ================== Process variables ================== -->
    <bpmn:extensionElements>
      <uipath:variable name="GitHubOrg"          type="string"        default="aurora-demo-org" />
      <uipath:variable name="ScanScope"          type="array&lt;string&gt;" default='["*"]' />
      <uipath:variable name="SeverityFloor"      type="number"        default="0.0" />
      <uipath:variable name="DigestChannel"      type="string"        default="${SLACK_CHANNEL_ID}" />
      <uipath:variable name="EmergencyApprovers" type="array&lt;string&gt;" default='["${AURORA_EMERGENCY_APPROVERS}"]' />
    </bpmn:extensionElements>

    <!-- ================== Start: Timer ================== -->
    <bpmn:startEvent id="Start_DailyScan" name="Every 6 hours">
      <bpmn:outgoing>Flow_Start_Resolve</bpmn:outgoing>
      <bpmn:timerEventDefinition>
        <bpmn:timeCycle xsi:type="bpmn:tFormalExpression">0 */6 * * *</bpmn:timeCycle>
      </bpmn:timerEventDefinition>
    </bpmn:startEvent>

    <bpmn:sequenceFlow id="Flow_Start_Resolve" sourceRef="Start_DailyScan" targetRef="ResolveLockfiles" />

    <!-- ================== Service Task: Resolve repos & fetch lockfiles ================== -->
    <bpmn:serviceTask id="ResolveLockfiles" name="Resolve repos and fetch lockfiles">
      <bpmn:extensionElements>
        <uipath:taskBinding kind="coded-workflow"
                            packageId="AuroraSupplyChainDefender"
                            entryPoint="GitHub.ResolveLockfiles" />
        <uipath:input  name="org"   from="GitHubOrg" />
        <uipath:input  name="scope" from="ScanScope" />
        <uipath:output name="lockfiles" to="lockfiles" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Start_Resolve</bpmn:incoming>
      <bpmn:outgoing>Flow_Resolve_FanOut</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:sequenceFlow id="Flow_Resolve_FanOut" sourceRef="ResolveLockfiles" targetRef="FanOut" />

    <!-- ================== Parallel Gateway: fan out to 4 branches ================== -->
    <bpmn:parallelGateway id="FanOut" name="Fan out">
      <bpmn:incoming>Flow_Resolve_FanOut</bpmn:incoming>
      <bpmn:outgoing>Flow_FanOut_Vuln</bpmn:outgoing>
      <bpmn:outgoing>Flow_FanOut_Maintainer</bpmn:outgoing>
      <bpmn:outgoing>Flow_FanOut_Typosquat</bpmn:outgoing>
      <bpmn:outgoing>Flow_FanOut_License</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Branch A: VulnLookup AI Agent -->
    <bpmn:sequenceFlow id="Flow_FanOut_Vuln" sourceRef="FanOut" targetRef="VulnLookup" />
    <bpmn:serviceTask id="VulnLookup" name="NVD/OSV/Advisory cross-reference">
      <bpmn:extensionElements>
        <uipath:taskBinding kind="coded-agent"
                            packageId="AuroraVulnLookup"
                            framework="langgraph"
                            entryPoint="main:main" />
        <uipath:input  name="lockfiles" from="lockfiles" />
        <uipath:output name="findings"  to="vuln_findings" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_FanOut_Vuln</bpmn:incoming>
      <bpmn:outgoing>Flow_Vuln_Join</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_Vuln_Join" sourceRef="VulnLookup" targetRef="JoinFanOut" />

    <!-- Branch B: MaintainerHealth AI Agent -->
    <bpmn:sequenceFlow id="Flow_FanOut_Maintainer" sourceRef="FanOut" targetRef="MaintainerHealth" />
    <bpmn:serviceTask id="MaintainerHealth" name="Maintainer health (Scorecard + commit recency)">
      <bpmn:extensionElements>
        <uipath:taskBinding kind="coded-agent"
                            packageId="AuroraMaintainerHealth"
                            framework="openai-agents"
                            entryPoint="main:main" />
        <uipath:input  name="lockfiles"        from="lockfiles" />
        <uipath:output name="maintainer_score" to="maintainer_score" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_FanOut_Maintainer</bpmn:incoming>
      <bpmn:outgoing>Flow_Maintainer_Join</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_Maintainer_Join" sourceRef="MaintainerHealth" targetRef="JoinFanOut" />

    <!-- Branch C: TyposquatCheck Coded Workflow (C#) -->
    <bpmn:sequenceFlow id="Flow_FanOut_Typosquat" sourceRef="FanOut" targetRef="TyposquatCheck" />
    <bpmn:serviceTask id="TyposquatCheck" name="Typosquat detection (npm/PyPI)">
      <bpmn:extensionElements>
        <uipath:taskBinding kind="coded-workflow"
                            packageId="AuroraSupplyChainDefender"
                            entryPoint="Typosquat.CheckLockfiles" />
        <uipath:input  name="lockfiles" from="lockfiles" />
        <uipath:output name="suspects"  to="typosquat_suspects" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_FanOut_Typosquat</bpmn:incoming>
      <bpmn:outgoing>Flow_Typosquat_Join</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_Typosquat_Join" sourceRef="TyposquatCheck" targetRef="JoinFanOut" />

    <!-- Branch D: LicenseDrift XAML -->
    <bpmn:sequenceFlow id="Flow_FanOut_License" sourceRef="FanOut" targetRef="LicenseDrift" />
    <bpmn:serviceTask id="LicenseDrift" name="License drift (declared vs transitive)">
      <bpmn:extensionElements>
        <uipath:taskBinding kind="rpa-package"
                            packageId="AuroraSupplyChainDefender"
                            entryPoint="License/CheckLicenseDrift" />
        <uipath:input  name="lockfiles" from="lockfiles" />
        <uipath:output name="conflicts" to="license_conflicts" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_FanOut_License</bpmn:incoming>
      <bpmn:outgoing>Flow_License_Join</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_License_Join" sourceRef="LicenseDrift" targetRef="JoinFanOut" />

    <!-- ================== Parallel Gateway: join ================== -->
    <bpmn:parallelGateway id="JoinFanOut" name="Join">
      <bpmn:incoming>Flow_Vuln_Join</bpmn:incoming>
      <bpmn:incoming>Flow_Maintainer_Join</bpmn:incoming>
      <bpmn:incoming>Flow_Typosquat_Join</bpmn:incoming>
      <bpmn:incoming>Flow_License_Join</bpmn:incoming>
      <bpmn:outgoing>Flow_Join_Score</bpmn:outgoing>
    </bpmn:parallelGateway>

    <bpmn:sequenceFlow id="Flow_Join_Score" sourceRef="JoinFanOut" targetRef="ScoreSeverity" />

    <!-- ================== Business Rule Task: DMN severity matrix ================== -->
    <bpmn:businessRuleTask id="ScoreSeverity" name="Severity classification (DMN)">
      <bpmn:extensionElements>
        <uipath:dmnBinding decisionRef="severity-matrix" />
        <uipath:input name="cvss"            from="vuln_findings.max_cvss" />
        <uipath:input name="exploitInWild"   from="vuln_findings.has_known_exploit" />
        <uipath:input name="depDepth"        from="vuln_findings.shallowest_depth" />
        <uipath:input name="maintainerHealth" from="maintainer_score" />
        <uipath:input name="licenseRisk"     from="license_conflicts.has_conflict" />
        <uipath:output name="severity"       to="severity" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Join_Score</bpmn:incoming>
      <bpmn:outgoing>Flow_Score_Route</bpmn:outgoing>
    </bpmn:businessRuleTask>

    <bpmn:sequenceFlow id="Flow_Score_Route" sourceRef="ScoreSeverity" targetRef="RouteSeverity" />

    <!-- ================== Exclusive Gateway: route by severity ================== -->
    <bpmn:exclusiveGateway id="RouteSeverity" name="Severity?">
      <bpmn:incoming>Flow_Score_Route</bpmn:incoming>
      <bpmn:outgoing>Flow_Route_Critical</bpmn:outgoing>
      <bpmn:outgoing>Flow_Route_High</bpmn:outgoing>
      <bpmn:outgoing>Flow_Route_Medium</bpmn:outgoing>
      <bpmn:outgoing>Flow_Route_Low</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:sequenceFlow id="Flow_Route_Critical" name="critical" sourceRef="RouteSeverity" targetRef="CriticalSubProcess">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${severity == "critical"}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Route_High" name="high" sourceRef="RouteSeverity" targetRef="OpenAutoPR">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${severity == "high"}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Route_Medium" name="medium" sourceRef="RouteSeverity" targetRef="BatchDigest">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${severity == "medium"}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Route_Low" name="low" sourceRef="RouteSeverity" targetRef="LogOnly">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${severity == "low" || severity == "informational"}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>

    <!-- ================== Critical sub-process ================== -->
    <bpmn:subProcess id="CriticalSubProcess" name="Critical: triage → approve → patch → verify">
      <bpmn:incoming>Flow_Route_Critical</bpmn:incoming>
      <bpmn:outgoing>Flow_Critical_End</bpmn:outgoing>

      <bpmn:startEvent id="Critical_Start"><bpmn:outgoing>Flow_C_Start_Triage</bpmn:outgoing></bpmn:startEvent>
      <bpmn:sequenceFlow id="Flow_C_Start_Triage" sourceRef="Critical_Start" targetRef="Triage" />

      <!-- AI Agent: Triage -->
      <bpmn:serviceTask id="Triage" name="Triage and propose remediation">
        <bpmn:extensionElements>
          <uipath:taskBinding kind="coded-agent"
                              packageId="AuroraVulnLookup"
                              framework="langgraph"
                              entryPoint="main:triage" />
          <uipath:input  name="findings" from="vuln_findings" />
          <uipath:output name="triage_summary" to="triage_summary" />
          <uipath:output name="proposed_diff"  to="proposed_diff" />
        </bpmn:extensionElements>
        <bpmn:incoming>Flow_C_Start_Triage</bpmn:incoming>
        <bpmn:outgoing>Flow_C_Triage_Approve</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:sequenceFlow id="Flow_C_Triage_Approve" sourceRef="Triage" targetRef="ApproveEmergencyPatch" />

      <!-- User Task: Action Center approval (with boundary timer) -->
      <bpmn:userTask id="ApproveEmergencyPatch" name="Security lead: approve emergency patch">
        <bpmn:extensionElements>
          <uipath:taskBinding kind="action-center-form"
                              catalog="aurora_supply_chain_approvals"
                              formRef="emergency-patch-approval" />
          <uipath:approvers from="EmergencyApprovers" />
          <uipath:input name="triage_summary" from="triage_summary" />
          <uipath:input name="diff_url"       from="proposed_diff.url" />
          <uipath:output name="decision"      to="approval_decision" />
        </bpmn:extensionElements>
        <bpmn:incoming>Flow_C_Triage_Approve</bpmn:incoming>
        <bpmn:outgoing>Flow_C_Approve_Branch</bpmn:outgoing>
      </bpmn:userTask>

      <!-- Boundary: 4h timeout escalates -->
      <bpmn:boundaryEvent id="ApprovalTimer" attachedToRef="ApproveEmergencyPatch" cancelActivity="false">
        <bpmn:outgoing>Flow_C_Timer_Escalate</bpmn:outgoing>
        <bpmn:timerEventDefinition>
          <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">PT4H</bpmn:timeDuration>
        </bpmn:timerEventDefinition>
      </bpmn:boundaryEvent>
      <bpmn:sequenceFlow id="Flow_C_Timer_Escalate" sourceRef="ApprovalTimer" targetRef="EscalateApproval" />

      <bpmn:sendTask id="EscalateApproval" name="Escalate to backup approvers">
        <bpmn:extensionElements>
          <uipath:taskBinding kind="action-center-form"
                              catalog="aurora_supply_chain_approvals"
                              formRef="emergency-patch-approval" />
          <uipath:approvers value="backup-pool" />
        </bpmn:extensionElements>
        <bpmn:incoming>Flow_C_Timer_Escalate</bpmn:incoming>
      </bpmn:sendTask>

      <bpmn:sequenceFlow id="Flow_C_Approve_Branch" sourceRef="ApproveEmergencyPatch" targetRef="ApproveBranch" />

      <!-- Branch on approval -->
      <bpmn:exclusiveGateway id="ApproveBranch" name="Approved?">
        <bpmn:incoming>Flow_C_Approve_Branch</bpmn:incoming>
        <bpmn:outgoing>Flow_C_Yes_OpenPR</bpmn:outgoing>
        <bpmn:outgoing>Flow_C_No_End</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:sequenceFlow id="Flow_C_Yes_OpenPR" name="approve" sourceRef="ApproveBranch" targetRef="OpenPatchPR">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${approval_decision == "approve"}</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="Flow_C_No_End" name="reject" sourceRef="ApproveBranch" targetRef="Critical_End">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${approval_decision != "approve"}</bpmn:conditionExpression>
      </bpmn:sequenceFlow>

      <!-- Open patch PR -->
      <bpmn:serviceTask id="OpenPatchPR" name="Open patch PR (auto-merge per policy)">
        <bpmn:extensionElements>
          <uipath:taskBinding kind="coded-workflow"
                              packageId="AuroraSupplyChainDefender"
                              entryPoint="GitHub.OpenPatchPR" />
          <uipath:input  name="findings" from="vuln_findings" />
          <uipath:input  name="diff"     from="proposed_diff" />
          <uipath:output name="pr_url"   to="pr_url" />
        </bpmn:extensionElements>
        <bpmn:incoming>Flow_C_Yes_OpenPR</bpmn:incoming>
        <bpmn:outgoing>Flow_C_PR_WaitCI</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:sequenceFlow id="Flow_C_PR_WaitCI" sourceRef="OpenPatchPR" targetRef="WaitForCI" />

      <!-- Wait for CI -->
      <bpmn:receiveTask id="WaitForCI" name="Wait for CI (GitHub webhook)">
        <bpmn:extensionElements>
          <uipath:messageEventDefinition messageRef="github-checks-completed" correlation="pr_url" />
        </bpmn:extensionElements>
        <bpmn:incoming>Flow_C_PR_WaitCI</bpmn:incoming>
        <bpmn:outgoing>Flow_C_CI_AutoMerge</bpmn:outgoing>
      </bpmn:receiveTask>
      <bpmn:sequenceFlow id="Flow_C_CI_AutoMerge" sourceRef="WaitForCI" targetRef="AutoMerge" />

      <!-- Auto-merge if green per DMN -->
      <bpmn:businessRuleTask id="AutoMerge" name="Auto-merge if green (DMN policy)">
        <bpmn:extensionElements>
          <uipath:dmnBinding decisionRef="auto-merge-policy" />
          <uipath:input  name="severity"     from="severity" />
          <uipath:input  name="ciResult"     from="ci_result" />
          <uipath:input  name="filesTouched" from="proposed_diff.files_touched" />
          <uipath:output name="action"       to="merge_action" />
        </bpmn:extensionElements>
        <bpmn:incoming>Flow_C_CI_AutoMerge</bpmn:incoming>
        <bpmn:outgoing>Flow_C_Merge_Notify</bpmn:outgoing>
      </bpmn:businessRuleTask>
      <bpmn:sequenceFlow id="Flow_C_Merge_Notify" sourceRef="AutoMerge" targetRef="Notify" />

      <!-- Notify (Slack + audit log) -->
      <bpmn:sendTask id="Notify" name="Notify (Slack + audit)">
        <bpmn:extensionElements>
          <uipath:taskBinding kind="coded-workflow"
                              packageId="AuroraSupplyChainDefender"
                              entryPoint="Notify.SendDigest" />
          <uipath:input name="channel" from="DigestChannel" />
          <uipath:input name="payload" from="merge_action" />
        </bpmn:extensionElements>
        <bpmn:incoming>Flow_C_Merge_Notify</bpmn:incoming>
        <bpmn:outgoing>Flow_C_Notify_End</bpmn:outgoing>
      </bpmn:sendTask>
      <bpmn:sequenceFlow id="Flow_C_Notify_End" sourceRef="Notify" targetRef="Critical_End" />

      <bpmn:endEvent id="Critical_End">
        <bpmn:incoming>Flow_C_No_End</bpmn:incoming>
        <bpmn:incoming>Flow_C_Notify_End</bpmn:incoming>
      </bpmn:endEvent>
    </bpmn:subProcess>
    <bpmn:sequenceFlow id="Flow_Critical_End" sourceRef="CriticalSubProcess" targetRef="End_RunComplete" />

    <!-- ================== High path: auto-PR (no HITL by default) ================== -->
    <bpmn:serviceTask id="OpenAutoPR" name="Auto-PR with version bump">
      <bpmn:extensionElements>
        <uipath:taskBinding kind="coded-workflow"
                            packageId="AuroraSupplyChainDefender"
                            entryPoint="GitHub.OpenAutoPR" />
        <uipath:input  name="findings" from="vuln_findings" />
        <uipath:output name="pr_url"   to="pr_url" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Route_High</bpmn:incoming>
      <bpmn:outgoing>Flow_High_End</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_High_End" sourceRef="OpenAutoPR" targetRef="End_RunComplete" />

    <!-- ================== Medium path: batch digest ================== -->
    <bpmn:serviceTask id="BatchDigest" name="Batch into weekly digest">
      <bpmn:extensionElements>
        <uipath:taskBinding kind="coded-workflow"
                            packageId="AuroraSupplyChainDefender"
                            entryPoint="Notify.AppendToDigest" />
        <uipath:input name="findings" from="vuln_findings" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Route_Medium</bpmn:incoming>
      <bpmn:outgoing>Flow_Medium_End</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_Medium_End" sourceRef="BatchDigest" targetRef="End_RunComplete" />

    <!-- ================== Low path: log only ================== -->
    <bpmn:scriptTask id="LogOnly" name="Append to audit log" scriptFormat="javascript">
      <bpmn:extensionElements>
        <uipath:scriptBody><![CDATA[
audit.append({ severity: severity, count: vuln_findings.length, ts: new Date().toISOString() });
        ]]></uipath:scriptBody>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Route_Low</bpmn:incoming>
      <bpmn:outgoing>Flow_Low_End</bpmn:outgoing>
    </bpmn:scriptTask>
    <bpmn:sequenceFlow id="Flow_Low_End" sourceRef="LogOnly" targetRef="End_RunComplete" />

    <!-- ================== End: emit to Insights ================== -->
    <bpmn:endEvent id="End_RunComplete" name="Run complete">
      <bpmn:incoming>Flow_Critical_End</bpmn:incoming>
      <bpmn:incoming>Flow_High_End</bpmn:incoming>
      <bpmn:incoming>Flow_Medium_End</bpmn:incoming>
      <bpmn:incoming>Flow_Low_End</bpmn:incoming>
      <bpmn:extensionElements>
        <uipath:emitToInsights metric="oss_supply_chain_run" />
      </bpmn:extensionElements>
    </bpmn:endEvent>

  </bpmn:process>
</bpmn:definitions>
