{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/hooks/pre-tool-load-memory.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/hooks/post-tool-fingerprint.sh"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/hooks/user-prompt-deploy-gate.sh"
          }
        ]
      }
    ],
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/hooks/notification-action-center.sh"
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(uipath *)",
      "Bash(uv *)",
      "Bash(git *)",
      "Bash(curl https://api.github.com/*)",
      "Bash(curl https://services.nvd.nist.gov/*)",
      "Bash(curl https://api.osv.dev/*)",
      "Bash(curl https://api.scorecard.dev/*)",
      "Bash(curl *.uipath.com/*)"
    ],
    "deny": [
      "Bash(rm -rf /*)",
      "Bash(curl https://*.anthropic.com/v1/messages*)"
    ]
  }
}