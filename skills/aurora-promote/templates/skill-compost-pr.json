{
  "aurora": {
    "kind": "skill_compost_pr",
    "default_timeout_hours": 72,
    "default_on_timeout": "deny",
    "default_approvers_env": "AURORA_EMERGENCY_APPROVERS",
    "priority": "Low"
  },
  "form": {
    "title": "AURORA: skill update from compost step",
    "display": "form",
    "components": [
      { "type": "htmlelement", "key": "header", "tag": "h3", "content": "Compost-step skill update — {{ skill_name }}" },
      {
        "type": "panel",
        "title": "Why",
        "components": [
          { "type": "textarea", "key": "rationale", "label": "Pattern observed", "defaultValue": "{{ rationale }}", "rows": 5, "disabled": true },
          { "type": "number", "key": "occurrences", "label": "Occurrences this period", "defaultValue": "{{ occurrences }}", "disabled": true },
          { "type": "url", "key": "pr_url", "label": "PR", "defaultValue": "{{ pr_url }}", "disabled": true }
        ]
      },
      {
        "type": "select",
        "key": "decision",
        "label": "Decision",
        "data": {
          "values": [
            { "label": "Approve — merge skill update", "value": "approve" },
            { "label": "Reject — abandon", "value": "reject" },
            { "label": "Defer — revisit next compost", "value": "defer" }
          ]
        },
        "validate": { "required": true }
      },
      { "type": "textarea", "key": "notes", "label": "Notes", "rows": 3 },
      { "type": "button", "key": "submit", "label": "Submit", "action": "submit", "theme": "primary" }
    ]
  }
}
